# Radiant Node RPC credentials
RPC_USER=radiant
RPC_PASS=your_secure_password_here

# ElectrumX settings
CACHE_MB=2000
MAX_SESSIONS=10000

# Email to send you notifications about certificate expiration
EMAIL=admin@yourdomain.com

# Cloudflare SSL Settings
DOMAIN=yourdomain.com
CLOUDFLARE_TOKEN=your_cloudflare_api_token_here
