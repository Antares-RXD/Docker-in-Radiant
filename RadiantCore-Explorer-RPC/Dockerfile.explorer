FROM node:lts-slim

# Install git and python (build dependencies often needed for old npm packages)
RUN apt-get update -q && \
    apt-get install -qy git python3 make g++ && \
    rm -rf /var/lib/apt/lists/* && \
    apt-get clean

WORKDIR /workspace

# Clone the repository directly
RUN git clone https://github.com/RadiantBlockchain-Community/rxd-rpc-explorer.git .

# Install dependencies and PM2 globally
RUN npm install && \
    npm install -g pm2

# Expose port
EXPOSE 3002

# Start the application using PM2
CMD ["pm2-runtime", "start", "bin/www", "--name", "rxd-rpc-explorer"]
